{
  "name": "dsh-git-tools",
  "version": "1.3.0",
  "type": "module",
  "description": "Git tools and /git slash commands for DeepSeek Harness, running git in the Host process so push, pull and fetch work even when the session shell is sandboxed.",
  "license": "MIT",
  "icon": "./icon.svg",
  "meta": {
    "title": "Git tools",
    "description": "Git tools for the agent plus /git slash commands for people. Runs git in the Host process, so push/pull/fetch work even when the session shell is sandboxed."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yangi-252410/dsh-import-repositories.git"
  },
  "homepage": "https://github.com/Yangi-252410/dsh-import-repositories#readme",
  "bugs": {
    "url": "https://github.com/Yangi-252410/dsh-import-repositories/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek",
    "deepseek-harness",
    "cordis",
    "git",
    "slash-commands",
    "agent-tools"
  ],
  "author": "Yangi",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
